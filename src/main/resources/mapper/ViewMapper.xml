<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mhua.adminbackend.mapper.ViewMapper">

    <insert id="insert" keyColumn="id" useGeneratedKeys="true" keyProperty="id">
        insert into sys_view (table_id, name, config, create_time, update_time, create_user, update_user, sign)
        values (#{tableId}, #{name}, #{config}, #{createTime}, #{updateTime}, #{createUser}, #{updateUser}, #{sign})
    </insert>

    <update id="update">
        update sys_view
        <set>
            <if test="config != null">
                config = #{config},
            </if>
            <if test="updateTime != null">
                update_time = #{updateTime},
            </if>
            <if test="updateUser != null">
                update_user = #{updateUser},
            </if>
        </set>
        where id = #{id}
    </update>

    <delete id="delete">
        delete from sys_view where id in
                             <foreach item="id" collection="ids" separator="," open="(" close=")">
                                 #{id}
                             </foreach>
    </delete>

    <select id="list" resultType="com.mhua.adminbackend.pojo.entity.View">
        select * from sys_view
        <where>
            <if test="tableId != null">
                AND table_id = #{tableId}
            </if>
        </where>
    </select>

    <select id="getById" resultType="com.mhua.adminbackend.pojo.entity.View">
        select * from sys_view where id = #{id}
    </select>

    <select id="getBySign" resultType="com.mhua.adminbackend.pojo.entity.View">
        select * from sys_view where sign = #{sign}
    </select>

    <select id="getAll" resultType="com.mhua.adminbackend.pojo.vo.ViewAllVO">
        select t.name as tableName, t.`desc`, v.sign, v.id, v.table_id  from sys_view v left join sys_table t on v.table_id = t.id
    </select>
</mapper>
