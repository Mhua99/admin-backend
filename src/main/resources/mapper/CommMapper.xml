<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mhua.adminbackend.mapper.CommMapper">

    <delete id="delete">
        delete from ${tableName} where id = #{id}
    </delete>

    <select id="getTableNameByySign" resultType="java.lang.String">
        select t.name from sys_view v left join sys_table t on v.table_id = t.id where v.sign = #{sign}
    </select>

</mapper>